{
  "name": "safar-backend",
  "version": "1.0.0",
  "description": "REST API for SAFAR, a student gig and part-time job marketplace for J&K. Zero npm dependencies.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "admin:create": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/create-admin.js"
  }
}
