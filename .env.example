
PORT=3000
DB_PATH=data/safar.db

# Secret used for signing authentication tokens
JWT_SECRET=Safar-Local-Dev-Secret-Change-This-2026-Strong

# Environment
NODE_ENV=development

# Browser API settings
CORS_ORIGIN=
TRUST_PROXY=0

# Demo accounts
SEED_DEMO_USERS=

# Demo reset disabled
ALLOW_DEMO_RESET=0

# Admin account setup
ADMIN_EMAIL=admin@safar.local
ADMIN_PASSWORD=SafarAdmin-ChangeMe-2026!
ADMIN_NAME=SAFAR Admin

# Rate limits
AUTH_RATE_MAX=20
RATE_MAX=300
